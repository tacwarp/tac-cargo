# TAC Cargo Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# Site URL (for auth redirects in production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Enable debug mode (development only)
# DEBUG=true

# =============================================================================
# SENTRY CONFIGURATION
# =============================================================================
# Get these from your Sentry project dashboard:
# https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
#
# RUNTIME REQUIREMENTS:
# - NEXT_PUBLIC_SENTRY_DSN: Required for error tracking (client + server)
#
# BUILD-TIME REQUIREMENTS (for source maps upload):
# - SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN: Only needed during `next build`
# - If not set, the build will succeed but source maps won't be uploaded to Sentry

# Sentry DSN (Data Source Name)
# Used for client-side, server-side, and edge error reporting.
# This is the ONLY required variable for basic error tracking.
# Format: https://<key>@<org>.ingest.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry Organization Slug (BUILD-TIME ONLY)
# Used by the Sentry Webpack Plugin during build to upload source maps.
# Find at: https://sentry.io/settings/organization/
SENTRY_ORG=your-org-slug

# Sentry Project Name (BUILD-TIME ONLY)
# Identifies the specific project in Sentry for releases and source maps.
# Find at: https://sentry.io/settings/[your-org]/projects/
SENTRY_PROJECT=tac-cargo

# Sentry Auth Token (BUILD-TIME ONLY)
# Required for source map uploads and release management.
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, org:read
# SECURITY: Never commit this token. Use environment variables in CI/CD.
SENTRY_AUTH_TOKEN=your-auth-token-here
