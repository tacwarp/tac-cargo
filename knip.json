{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}"
  ],
  "project": ["**/*.{ts,tsx}"],
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "__tests__/**",
    "test/**",
    "components/dev-playground/**"
  ],
  "ignoreDependencies": [
    "@tailwindcss/forms",
    "tailwindcss",
    "eslint-plugin-tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
